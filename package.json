{
  "name": "my-cli",
  "version": "1.0.0",
  "description": "CLI-приложение для лабораторной работы №17",
  "main": "cli.js",
  "bin": {
    "my-cli": "bin/my-cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "build:binary": "pkg . --targets node22-win-x64 --output dist/my-cli-win.exe"
  },
  "keywords": [
    "cli",
    "nodejs",
    "laboratory-work"
  ],
  "author": "Иванов Иван",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "inquirer": "^8.2.6",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "services/**/*.js",
      "!services/testService.js"
    ],
    "coverageDirectory": "coverage"
  },
  "pkg": {
    "scripts": [
      "commands/**/*.js",
      "services/**/*.js",
      "utils/**/*.js"
    ],
    "outputPath": "dist"
  }
}
